# SMTP account the site sends mail FROM (Gmail example below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=youraddress@gmail.com
# For Gmail use an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_PASS=your-app-password

# Where new orders are delivered (your inbox)
ORDER_RECEIVER_EMAIL=youraddress@gmail.com

# Name shown on outgoing mail
STORE_NAME=iPhoneHub
